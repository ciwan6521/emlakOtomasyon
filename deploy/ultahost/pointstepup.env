# pointstepup.com — UltaHost production template
# Copy to project root: cp deploy/ultahost/pointstepup.env .env.production

NODE_ENV=production

APP_URL=https://pointstepup.com
API_PUBLIC_URL=https://api.pointstepup.com
API_CORS_ORIGINS=https://pointstepup.com,https://www.pointstepup.com

API_PORT=4000
API_GLOBAL_PREFIX=api/v1
API_HOST_PORT=4010

POSTGRES_USER=reos
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_DB=reos
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://reos:CHANGE_ME_DB_PASSWORD@postgres:5432/reos?schema=public

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

JWT_ACCESS_SECRET=CHANGE_ME_JWT_ACCESS_32_CHARS_MIN
JWT_ACCESS_TTL=900
JWT_REFRESH_SECRET=CHANGE_ME_JWT_REFRESH_32_CHARS_MIN
JWT_REFRESH_TTL=2592000

S3_ENDPOINT=http://minio:9000
S3_PUBLIC_URL=https://media.pointstepup.com
S3_REGION=us-east-1
S3_ACCESS_KEY=CHANGE_ME_MINIO_USER
S3_SECRET_KEY=CHANGE_ME_MINIO_PASSWORD
S3_BUCKET=reos-media
S3_FORCE_PATH_STYLE=true

RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=120

INTEGRATIONS_MODE=simulated
AI_PROVIDER=simulated
OPENAI_API_KEY=

WEB_HOST_PORT=3010
MINIO_HOST_PORT=9010

NEXT_PUBLIC_API_URL=https://api.pointstepup.com/api/v1
NEXT_PUBLIC_WS_URL=https://api.pointstepup.com
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

RUN_SEED=true
