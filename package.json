{
  "name": "reos",
  "version": "1.0.0",
  "private": true,
  "description": "REOS — real estate operations platform.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run start:dev --workspace @reos/api",
    "dev:web": "npm run dev --workspace @reos/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "prisma:generate": "npm run prisma:generate --workspace @reos/api",
    "prisma:migrate": "npm run prisma:migrate --workspace @reos/api",
    "prisma:seed": "npm run prisma:seed --workspace @reos/api",
    "infra:up": "docker compose up -d postgres redis minio",
    "infra:down": "docker compose down",
    "prod:build": "docker compose --env-file .env.production -f docker-compose.prod.yml build",
    "prod:up": "docker compose --env-file .env.production -f docker-compose.prod.yml up -d",
    "prod:down": "docker compose --env-file .env.production -f docker-compose.prod.yml down",
    "prod:logs": "docker compose --env-file .env.production -f docker-compose.prod.yml logs -f",
    "prod:ps": "docker compose --env-file .env.production -f docker-compose.prod.yml ps"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "^5.6.3"
  }
}
