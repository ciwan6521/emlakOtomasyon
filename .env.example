# REOS environment (copy to .env)

NODE_ENV=development

# API
API_PORT=4000
API_GLOBAL_PREFIX=api/v1
API_CORS_ORIGINS=http://localhost:3000

# Database
POSTGRES_USER=reos
POSTGRES_PASSWORD=reos_dev_password
POSTGRES_DB=reos
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://reos:reos_dev_password@localhost:5432/reos?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Auth
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars_long
JWT_ACCESS_TTL=900
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars_long
JWT_REFRESH_TTL=2592000

# Object storage (MinIO)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=reos-minio
S3_SECRET_KEY=reos-minio-secret
S3_BUCKET=reos-media
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=http://localhost:9000

# Rate limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=120

# Integrations (simulated | live)
# Channels with missing credentials fall back to simulation even in live mode.
INTEGRATIONS_MODE=simulated

# WhatsApp Cloud API. APP_SECRET signs status webhooks, VERIFY_TOKEN is the
# value Meta echoes during webhook subscription.
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# Viber Business Messages (Public Account). The auth token also signs webhooks.
VIBER_AUTH_TOKEN=
VIBER_SENDER_NAME=REOS
VIBER_SENDER_AVATAR=

TELEGRAM_BOT_TOKEN=
META_GRAPH_TOKEN=
IG_BUSINESS_ACCOUNT_ID=
FB_PAGE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# SMTP transport, e.g. smtps://user:pass@smtp.example.com:465
SMTP_URL=
SMTP_FROM=

GOOGLE_MAPS_API_KEY=

# Listing copy provider (simulated | openai)
AI_PROVIDER=simulated
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_WS_URL=http://localhost:4000
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Shows the seeded demo accounts on the login screen. Never enable in production.
NEXT_PUBLIC_ENABLE_DEMO_LOGIN=true
