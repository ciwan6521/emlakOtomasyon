# Production environment — copy to .env.production and fill in real values.

NODE_ENV=production

# Public URLs (used by browser + CORS)
APP_URL=https://app.example.com
API_PUBLIC_URL=https://api.example.com
API_CORS_ORIGINS=https://app.example.com

# API
API_PORT=4000
API_GLOBAL_PREFIX=api/v1

# Database (docker service name: postgres)
POSTGRES_USER=reos
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=reos
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://reos:CHANGE_ME_STRONG_DB_PASSWORD@postgres:5432/reos?schema=public

# Redis (docker service name: redis)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Auth — generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=CHANGE_ME_MIN_32_CHARS_ACCESS_SECRET
JWT_ACCESS_TTL=900
JWT_REFRESH_SECRET=CHANGE_ME_MIN_32_CHARS_REFRESH_SECRET
JWT_REFRESH_TTL=2592000

# Object storage (MinIO in compose, or AWS S3 in cloud)
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_URL=https://media.example.com
S3_REGION=us-east-1
S3_ACCESS_KEY=CHANGE_ME_S3_ACCESS_KEY
S3_SECRET_KEY=CHANGE_ME_S3_SECRET_KEY
S3_BUCKET=reos-media
S3_FORCE_PATH_STYLE=true

# Rate limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=120

# Integrations (simulated | live)
# Channels with missing credentials fall back to simulation even in live mode.
# Check Settings → Integrations in the app to see the resolved per-channel state.
INTEGRATIONS_MODE=simulated

WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

VIBER_AUTH_TOKEN=
VIBER_SENDER_NAME=REOS
VIBER_SENDER_AVATAR=

TELEGRAM_BOT_TOKEN=
META_GRAPH_TOKEN=
IG_BUSINESS_ACCOUNT_ID=
FB_PAGE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

SMTP_URL=
SMTP_FROM=

GOOGLE_MAPS_API_KEY=

# Listing copy (simulated | openai)
AI_PROVIDER=simulated
OPENAI_API_KEY=

# Frontend build/runtime (must match public API URL)
WEB_PORT=3000
NEXT_PUBLIC_API_URL=https://api.example.com/api/v1
NEXT_PUBLIC_WS_URL=https://api.example.com
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Leave unset in production; enabling this exposes the seeded demo accounts.
NEXT_PUBLIC_ENABLE_DEMO_LOGIN=false

# First deploy only: set true once to seed demo data, then false
RUN_SEED=false
